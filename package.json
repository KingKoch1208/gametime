{
  "name": "gametime",
  "version": "1.0.0",
  "type": "module",
  "description": "GameTime — Never Miss a Game",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd .. && cd client && npm install",
    "dev": "concurrently -k --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "vercel-build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
